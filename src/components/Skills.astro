---
import Section from './Section.astro';
import { getDictionary, type Lang } from '../i18n/utils';
import { skills } from '../data/profile';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Section id="skills" index="04" title={t.skills.title}>
	<div class="groups">
		<div>
			<h3 class="group-title mono">{t.skills.dailyTitle}</h3>
			<ul class="daily">
				{skills.daily.map((skill) => <li>{skill}</li>)}
			</ul>
		</div>
		<div>
			<h3 class="group-title mono">{t.skills.alsoTitle}</h3>
			<ul class="also mono">
				{skills.also.map((skill) => <li>{skill}</li>)}
			</ul>
		</div>
	</div>
</Section>

<style>
	.groups {
		display: grid;
		gap: var(--space-lg);
		max-width: 46rem;
	}

	.group-title {
		margin-bottom: var(--space-sm);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		padding: 0;
		list-style: none;
	}

	/* Lo de uso diario, grande y con un nodo delante de cada elemento */
	.daily {
		gap: 0.5rem 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.5vw, 1.625rem);
		letter-spacing: -0.01em;
	}

	.daily li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.daily li::before {
		content: '';
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		border: 1.5px solid var(--color-accent);
	}

	.also {
		gap: 0.5rem 1.5rem;
		color: var(--color-text-muted);
		font-size: 0.875rem;
	}
</style>
