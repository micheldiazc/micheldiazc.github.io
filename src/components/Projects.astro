---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { getDictionary, type Lang } from '../i18n/utils';
import { techTags, projectLinks } from '../data/profile';
import cotizaPanel from '../assets/cotiza-panel.png';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const project = t.projects.cotiza;
const links = projectLinks.cotiza;
---

<Section id="projects" index="03" title={t.projects.title}>
	<article class="case" aria-labelledby="cotiza-title">
		<header class="case-head">
			<p class="meta mono">
				<span class="status" aria-hidden="true"></span>
				{project.meta}
			</p>
			<h3 id="cotiza-title">
				{project.name}
				<span class="subtitle">{project.subtitle}</span>
			</h3>
			<p class="origin">{project.origin}</p>
		</header>

		<a class="shot" href={links.demo} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
			<Image
				src={cotizaPanel}
				alt=""
				widths={[640, 960, 1280, 2560]}
				sizes="(min-width: 60rem) 50rem, 100vw"
				loading="lazy"
			/>
		</a>
		<p class="visually-hidden">{project.imageAlt}</p>

		<ul class="features mono">
			{project.features.map((feature) => <li>{feature}</li>)}
		</ul>

		<div class="actions">
			<a class="button primary" href={links.demo} target="_blank" rel="noopener noreferrer">
				{project.demo} <span aria-hidden="true">↗</span>
				<span class="visually-hidden">{project.newTab}</span>
			</a>
			<a class="button" href={links.code} target="_blank" rel="noopener noreferrer">
				{project.code} <span aria-hidden="true">↗</span>
				<span class="visually-hidden">{project.newTab}</span>
			</a>
		</div>

		<details class="tech">
			<summary class="mono">{project.techTitle}</summary>
			<ul>
				{project.tech.map((item) => <li>{item}</li>)}
			</ul>
			<p class="tags mono">{techTags.cotiza.join(' · ')}</p>
		</details>
	</article>
</Section>

<style>
	.case {
		display: grid;
		gap: var(--space-md);
		max-width: 50rem;
	}

	.case-head {
		display: grid;
		gap: var(--space-sm);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--color-text-muted);
	}

	/* Nodo relleno: hay una demo en línea */
	.status {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 4px var(--color-accent-soft);
	}

	h3 {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: clamp(2rem, 5vw, 3rem);
	}

	.subtitle {
		font-size: clamp(1.125rem, 2.5vw, 1.375rem);
		color: var(--color-accent);
		letter-spacing: -0.01em;
	}

	.origin {
		max-width: 40rem;
		color: var(--color-text-muted);
	}

	/* La captura enmarcada como una ventana, con un leve realce al pasar el ratón */
	.shot {
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		overflow: hidden;
		transition:
			border-color 0.2s var(--ease),
			transform 0.3s var(--ease);
	}

	.shot:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	.shot :global(img) {
		width: 100%;
		height: auto;
	}

	.features {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		padding: 0;
		list-style: none;
		color: var(--color-text);
	}

	.features li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.features li::before {
		content: '';
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		border: 1.5px solid var(--color-accent);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		padding: 0 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		font-weight: 500;
		font-size: 0.9375rem;
		text-decoration: none;
		transition:
			border-color 0.2s var(--ease),
			background-color 0.2s var(--ease);
	}

	.button:hover {
		border-color: var(--color-accent);
	}

	.button.primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
	}

	.button.primary:hover {
		background: color-mix(in srgb, var(--color-accent) 85%, var(--color-text));
	}

	/* Desplegable para quien quiera el detalle técnico */
	.tech {
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-sm);
	}

	.tech summary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		cursor: pointer;
		list-style: none;
	}

	.tech summary::-webkit-details-marker {
		display: none;
	}

	.tech summary::before {
		content: '▸';
		transition: transform 0.2s var(--ease);
	}

	.tech[open] summary::before {
		transform: rotate(90deg);
	}

	.tech ul {
		display: grid;
		gap: 0.5rem;
		margin-top: var(--space-xs);
		padding: 0;
		list-style: none;
		color: var(--color-text-muted);
	}

	.tech li {
		position: relative;
		padding-left: 1.25rem;
	}

	.tech li::before {
		content: '—';
		position: absolute;
		left: 0;
		color: var(--color-border);
	}

	.tags {
		margin-top: var(--space-sm);
		color: var(--color-accent);
	}
</style>
