---
import NodeLine from './NodeLine.astro';
import { getDictionary, type Lang } from '../i18n/utils';
import { profile } from '../data/profile';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section class="hero">
	<div class="container hero-inner">
		<p class="role mono">{t.hero.role}</p>
		<h1>
			<span class="name">{profile.name}</span>
			<span class="headline">{t.hero.headlineStart} <em>{t.hero.headlineAccent}</em></span>
		</h1>
		<p class="subheadline">{t.hero.subheadline}</p>

		<div class="actions">
			<a class="button primary" href={`mailto:${profile.email}`}>{t.hero.ctaEmail}</a>
			<a class="button" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
				{t.hero.ctaLinkedin}
				<span aria-hidden="true">↗</span>
			</a>
		</div>

		<div class="footer-row">
			<p class="location mono">{t.hero.location}</p>
			<div class="motif">
				<NodeLine nodes={4} active={3} />
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Cuadrícula sutil, solo en la cabecera */
		background-image:
			linear-gradient(var(--color-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
		background-size: 2rem 2rem;
		background-position: center top;
		border-bottom: 1px solid var(--color-border);
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: calc(92vh - var(--header-height));
		padding-block: var(--space-xl) var(--space-lg);
	}

	.role {
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin-bottom: var(--space-md);
	}

	h1 {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.name {
		font-family: var(--font-body);
		font-size: 1.0625rem;
		font-weight: 400;
		letter-spacing: 0;
		color: var(--color-text-muted);
	}

	.headline {
		max-width: 16ch;
		font-size: clamp(2.6rem, 7.5vw, 5.25rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.headline em {
		font-style: normal;
		color: var(--color-accent);
	}

	.subheadline {
		max-width: 36rem;
		margin-top: var(--space-md);
		font-size: clamp(1.0625rem, 2vw, 1.25rem);
		color: var(--color-text-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-lg);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		padding: 0 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		font-weight: 500;
		font-size: 0.9375rem;
		text-decoration: none;
		transition:
			border-color 0.2s var(--ease),
			background-color 0.2s var(--ease);
	}

	.button:hover {
		border-color: var(--color-accent);
	}

	.button.primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
	}

	.button.primary:hover {
		background: color-mix(in srgb, var(--color-accent) 85%, var(--color-text));
	}

	.footer-row {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin-top: var(--space-xl);
	}

	.location {
		flex: none;
		color: var(--color-text-muted);
	}

	.motif {
		flex: 1;
		max-width: 24rem;
	}
</style>
